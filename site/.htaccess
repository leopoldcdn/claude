# Teamora : réglages pour un hébergement Apache (la plupart des offres mutualisées avec PHP).
# Chaque bloc ne s'applique que si le module correspondant existe chez l'hébergeur.

# Les fichiers de réglages PHP ne s'affichent jamais dans le navigateur.
<IfModule mod_authz_core.c>
  <FilesMatch "^(config|envoi)\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

# Protections courantes du navigateur.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compression des pages, styles et scripts (la démo pèse environ 1,4 Mo, 350 Ko une fois compressée).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Mise en cache des polices et images (un mois). Pages, styles et scripts ne sont pas mis en cache longtemps : une mise à jour
# de la démo doit arriver tout de suite chez les visiteurs.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Passage forcé en HTTPS : retirez les « # » des 4 lignes ci-dessous UNE FOIS le certificat SSL actif chez l'hébergeur.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
